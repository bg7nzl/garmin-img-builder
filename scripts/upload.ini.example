[s3]
; 留空 access/secret 则走默认凭证（环境变量、~/.aws、实例角色）
aws_access_key_id =
aws_secret_access_key =
; R2 用 auto；AWS 官方 S3 填实际区域
region = auto
bucket = your-bucket-name
; Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
endpoint_url =
; R2 建议 path
addressing_style = path
prefix = osm-build

[source]
; 相对本仓库根目录，或写绝对路径
codepage = 936
gmap_dir = out/936/OSM China 936.gmap
img_file = out/936/gmapsupp.img
gmap_zip_name = gmap.zip
img_zip_name = img.zip
